# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. If empty, the server starts but persists nothing.
MONGODB_URI=

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── AI provider (NEVER expose these to the frontend) ─────────────────────
# true  → deterministic mock engine (no key needed, used in dev/demo)
# false → calls the configured provider below
USE_MOCK_AI=true
AI_PROVIDER=openai            # openai | (add anthropic/gemini adapters in services/providers)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ─── Storage (resume uploads) ──────────────────────────────────────────────
# local → disk storage in /uploads (dev). Swap in an S3 adapter later.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Payments (Indian gateway, wired at launch) ────────────────────────────
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (wired at launch) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
