# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-production-frontend.vercel.app

# ─── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. If empty, the server starts in demo mode.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/airesume?retryWrites=true&w=majority

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-for-production
JWT_EXPIRES_IN=7d

# ─── AI provider (NEVER expose these to the frontend) ─────────────────────
# true  → deterministic mock engine (no key needed, used in dev/demo)
# false → calls the configured provider below
USE_MOCK_AI=true
AI_PROVIDER=openai            # openai | anthropic | gemini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ─── Storage (resume uploads) ──────────────────────────────────────────────
# local → disk storage in /uploads (dev). Swap in an S3 adapter later.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Payments (Razorpay Indian Gateway) ─────────────────────────────────────
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_live_TT6ougVeZ9NNEo
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Email (wired at launch) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
