# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Firebase Admin (Optional for local standalone mode) ──────────────────────
# Download service account key from Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=airesume-9a8b5
FIREBASE_DATABASE_URL=https://airesume-9a8b5-default-rtdb.firebaseio.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── AI provider (NEVER expose secret keys to frontend) ─────────────────────
# true  → deterministic mock engine (no key needed, used in dev/demo)
# false → calls the configured provider below (e.g. Groq, Gemini, OpenAI)
USE_MOCK_AI=true
AI_PROVIDER=groq               # groq | gemini | openai
GROQ_API_KEY=your_groq_api_key # Get key at: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Storage (resume uploads) ──────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# ─── Payments ──────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
