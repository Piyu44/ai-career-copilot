# Frontend environment
# true  → built-in mock AI engine (default; no key required, used for demo/dev)
# false → AI calls proxy to the backend API (which holds the real AI_API_KEY)
VITE_USE_MOCK_AI=true

# Backend API base URL (used when VITE_USE_MOCK_AI=false)
VITE_API_BASE_URL=http://localhost:5000/api
